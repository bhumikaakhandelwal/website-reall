# DBCE Coders Club — required environment variables
#
# Copy this file to .env.local and fill in real values. Never commit real
# credentials (.env* is gitignored; this example is the only file kept).

# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret used to sign the application session cookie (lib/auth/session.ts).
# Required — there is no fallback. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
